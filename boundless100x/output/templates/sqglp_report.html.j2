    {% if executive_summary.analyst %}
    <div style="flex: 0 0 auto; min-width: 200px; background: var(--bg-input); border-radius: 8px; padding: 12px 16px;">
      <div style="font-size: 0.8em; font-weight: 600; color: var(--gray); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px;">Analyst Consensus</div>
      <div style="font-size: 1.3em; font-weight: 700; color: var(--blue);">₹{{ "%.0f"|format(executive_summary.analyst.avg_target) }}</div>
      <div style="font-size: 0.8em; color: var(--text-secondary);">
        {{ executive_summary.analyst.count }} analyst{{ 's' if executive_summary.analyst.count != 1 else '' }} · {{ executive_summary.analyst.consensus | upper }}
        {% if executive_summary.analyst.upside is defined %}
        · <span style="color: {% if executive_summary.analyst.upside > 0 %}var(--green){% else %}var(--red){% endif %}; font-weight: 600;">{{ "%+.0f"|format(executive_summary.analyst.upside) }}%</span>
        {% endif %}
      </div>
      {% if executive_summary.analyst.dcf_intrinsic is not none %}
      <div style="font-size: 0.75em; color: var(--text-muted); margin-top: 4px;">DCF intrinsic: ₹{{ "%.0f"|format(executive_summary.analyst.dcf_intrinsic) }}</div>
      {% endif %}
    </div>
    {% endif %}
  </div>
  {% endif %}

  <!-- SQGLP Element Score Cards Row -->
  {% set el_scores = scores.get('elements', {}) %}
  <div class="sqglp-scores-row">
    {% for el_key, cfg in element_config.items() %}
    {% set sc = el_scores.get(el_key) %}
    <a href="#{{ el_key | replace('_', '-') }}" class="sqglp-score-card" style="text-decoration: none; color: inherit;">
      <div class="el-short">{{ cfg.short }}</div>
      <div class="el-score" style="color: {% if sc and sc >= 7 %}var(--green){% elif sc and sc >= 4 %}var(--amber){% else %}var(--red){% endif %};">
        {% if sc is not none %}{{ "%.1f"|format(sc) }}{% else %}—{% endif %}
      </div>
      <div class="el-label">{{ cfg.label }} ({{ cfg.weight }})</div>
      <div class="el-bar"><div class="el-bar-fill {% if sc and sc >= 7 %}score-high{% elif sc and sc >= 4 %}score-mid{% else %}score-low{% endif %}" style="width: {{ (sc or 0) * 10 }}%;"></div></div>
    </a>
    {% endfor %}
  </div>
</div>
{% endif %}

{# ═══════════════════════════════════════════════════════════════
   The reading layer's opening (R5, AE5).

   Everything above this is badges: a verdict chip whose explanation is a
   `title=` tooltip, an action chip whose cap reasons are the evaluator's own
   sentences. This says the same three things in prose — where the composite
   lands in words, what the action is and why the guard lowered it, and how
   many of the six sections below are open. That last one is the point: a
   reader comparing two companies should see which one has problems before
   reading either.
   ═══════════════════════════════════════════════════════════════ #}
{% if reading and reading.lead %}
<div class="card" style="margin-bottom: 30px;">
  <h3 style="margin-top: 0;">{{ reading.lead.title }}</h3>
  {{ surface.render_reading(reading.lead.reading) }}
  {% for finding in reading.lead.findings %}
  {{ surface.render_finding(finding) }}
  {% endfor %}
  {% for caveat in reading.lead.caveats %}
  {{ surface.render_caveat(caveat) }}
  {% endfor %}
</div>
{% endif %}


{# ═══════════════════════════════════════════════════════════════
   MACRO: Render a SQGLP element section
   Params: el_key, anchor_id, extra_content (block for charts etc.)
   ═══════════════════════════════════════════════════════════════ #}
{% macro render_element_section(el_key, anchor_id) %}
{% set cfg = element_config.get(el_key, {}) %}
{% set sc = scores.get('elements', {}).get(el_key) %}
{% set dd = score_drilldown.get(el_key, []) %}
{% set summary_text = element_summaries.get(el_key, '') %}
{% set section = reading.sections.get(el_key) if reading else none %}
{% set el_flags = [] %}
{% for f in flags if f.element == el_key %}{% if el_flags.append(f) %}{% endif %}{% endfor %}

<div id="{{ anchor_id }}"></div>
<h2>{{ cfg.label }} ({{ cfg.short }})</h2>
<div class="card">
  <!-- Header: score + weight + bar -->
  <div class="element-header">
    <div class="element-score-badge" style="color: {% if sc and sc >= 7 %}var(--green){% elif sc and sc >= 4 %}var(--amber){% else %}var(--red){% endif %};">
      {% if sc is not none %}{{ "%.1f"|format(sc) }}{% else %}—{% endif %}<span style="font-size: 0.4em; opacity: 0.6;">/10</span>
    </div>
    <div class="element-weight">Weight: {{ cfg.weight }}</div>
    <div class="element-bar">
      <div class="element-bar-fill {% if sc and sc >= 7 %}score-high{% elif sc and sc >= 4 %}score-mid{% else %}score-low{% endif %}" style="width: {{ (sc or 0) * 10 }}%;"></div>
    </div>
  </div>

  {# R5's one line, and R18's coverage clause when the section is thin. The
     score badge above is a number; this is the number in words, plus what
     share of the element's declared weight actually computed — a 6.9 scored on
     a third of the evidence reads exactly like a 6.9 scored on all of it
     unless somebody says so. #}
  {% if section %}
  {{ surface.render_reading(section.reading) }}
  {% endif %}

  <!-- Auto-generated summary -->
  {% if summary_text %}
  <div class="element-summary">{{ summary_text }}</div>
  {% endif %}

  {# The fired findings, and they are deliberately *outside* the disclosure
     below and *above* the table. PFC's Quality — Business scores asset
     turnover, the equity multiplier and free cash flow at zero because those
     three describe manufacturers and PFC is a lender; a reader who meets three
     zeroes before meeting that sentence has already drawn the wrong
     conclusion. A collapsed section has no findings by construction —
     `SectionDecision.expand` is `bool(reasons)` — so this loop renders nothing
     unless there is something to say. #}
  {% if section %}
  {% for finding in section.findings %}
  {{ surface.render_finding(finding) }}
  {% endfor %}
  {% endif %}

  {# The metric rows. Open when a trigger fired, closed otherwise (R5, AE5):
     the contrast between a section that opens itself and one that does not is
     the report telling a reader where to look. Nothing is hidden — a closed
     section is one click from every row it holds.

     `Metric | Reading | Contribution`, not the old `Metric | Value | Score |
     Weight`. That table put `0.09` (a ratio), `25.7` (a percentage), `2.0` (a
     count of years) and `0.84` (a coefficient of variation) in one column with
     nothing to tell them apart, beside two adjacent percentage columns meaning
     different things. Here every figure carries its unit and its direction of
     goodness and sits next to its own interpretation, and a metric that
     produced nothing says why instead of showing a dash. #}
  {% if section %}
  <details class="reading-rows"{% if section.expanded %} open{% endif %}>
    <summary>{{ reading.details_summary.format(count=section.rows|length) }}</summary>
    {% if section.rows %}
    <table class="reading-table">
      <thead><tr>
        <th>{{ reading.row_headers[0] }}</th><th>{{ reading.row_headers[1] }}</th><th>{{ reading.row_headers[2] }}</th>
      </tr></thead>
      <tbody>
      {% for row in section.rows %}
      {{ surface.render_metric_row(row) }}
      {% endfor %}
      </tbody>
    </table>
    {% endif %}
    {% if section.unknowns %}
    <ul class="unknowns">
    {% for unknown in section.unknowns %}
    {{ surface.render_unknown(unknown) }}
    {% endfor %}
    </ul>
    {% endif %}
    {% for caveat in section.caveats %}
    {{ surface.render_caveat(caveat) }}
    {% endfor %}
  </details>
  {% elif dd %}
  {# The degrade path, not a leftover. `_reading_or_none` returns None when the
     reading layer could not be built — a bad edit to one of the two
     hand-maintained YAML tables it reads is enough — and losing the section's
     metrics with it would make a display-table typo cost the dashboard its
     substance. So the drill-down the report has always had renders instead,
     and the reason is in Warnings & Errors. #}
  <table class="drilldown-table">
    <thead><tr><th>Metric</th><th>Value</th><th>Score</th><th>Weight</th></tr></thead>
    <tbody>
      {% for m in dd %}
      <tr class="contrib-{{ m.contribution }}">
        <td>{{ m.name }}</td>
        <td>{{ m.value }}</td>
        <td>{{ m.score_pct }}</td>
        <td style="color: var(--text-muted);">{{ m.weight }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}

  {# Element flags, unchanged. They stay chips rather than becoming findings
     because `finding_from_flag` builds a headline and no body — as a finding
     block a flag would say exactly what the chip says, four times as tall. #}
  {% if el_flags %}
  <div class="element-flags">
    {% for f in el_flags %}
    <span class="flag flag-{{ f.sentiment }}"><span class="flag-icon">{% if f.sentiment == 'good' %}&#10003;{% elif f.sentiment == 'bad' %}&#10007;{% else %}&#8226;{% endif %}</span> {{ f.label }}</span>
    {% endfor %}
  </div>
  {% endif %}
</div>
{% endmacro %}


<!-- ═══════════════════════════════════════════════════════ -->
