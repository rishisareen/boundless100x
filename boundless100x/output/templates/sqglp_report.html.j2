        <td style="text-align: right; font-weight: 600;" class="{% if e.delta > 0 %}score-high{% elif e.delta < 0 %}score-low{% else %}score-mid{% endif %}">
          {{ "%+.2f"|format(e.delta) }}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
  {% else %}
  <p>
    <strong>{{ forward_signals.momentum.label }}</strong>
    <span style="color: var(--gray);">— {{ forward_signals.momentum.reason }}</span>
  </p>
  {% endif %}
  {% endif %}
</div>
