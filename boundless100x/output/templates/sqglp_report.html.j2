<script>
function toggleTheme() {
  const html = document.documentElement;
  const current = html.getAttribute('data-theme');
  const next = current === 'dark' ? 'light' : 'dark';
  html.setAttribute('data-theme', next);
  try { localStorage.setItem('sqglp-theme', next); } catch(e) {}
}
(function() {
  try {
    const saved = localStorage.getItem('sqglp-theme');
    if (saved === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
  } catch(e) {}
})();
// Printing opens every collapsed section. A closed <details> prints as a
// heading with nothing under it, which is the empty-section failure this
// report exists to end — and there is no click on paper. Progressive
// enhancement only: the collapse itself is <details>, so it works with this
// script blocked, and an anchor link into an explanation still resolves.
(function() {
  const expandAll = () => document.querySelectorAll('details.reading-rows')
    .forEach(d => { d.dataset.wasOpen = d.open ? '1' : '0'; d.open = true; });
  const restore = () => document.querySelectorAll('details.reading-rows')
    .forEach(d => { d.open = d.dataset.wasOpen === '1'; });
  window.addEventListener('beforeprint', expandAll);
  window.addEventListener('afterprint', restore);
})();
</script>
</body>
</html>
