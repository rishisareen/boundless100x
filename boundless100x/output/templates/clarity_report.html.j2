{# The research note, in HTML. R14's first surface.

   The twin of `clarity_report.md.j2`: same loops, same order, same
   components — different punctuation. No Plotly, no charts and no external
   script of any kind; the note is prose and tables, and the seven figures stay
   in the dashboard this is generated beside (a Scope Boundary of the plan).

   Collapsed sections carry `class="collapsed"` rather than being hidden by
   script: R5's shape has to survive a printed page and a text-only reader. #}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ company }} — {{ title }}</title>
<style>
  :root {
    --bg: #ffffff; --panel: #f8fafc; --ink: #1e293b; --muted: #64748b;
    --line: #e2e8f0; --good: #16a34a; --bad: #dc2626; --neutral: #475569;
    --accent: #2563eb; --warn-bg: #fef3c7; --warn-ink: #92400e;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f172a; --panel: #1e293b; --ink: #f1f5f9; --muted: #94a3b8;
      --line: #334155; --good: #4ade80; --bad: #f87171; --neutral: #cbd5e1;
      --accent: #60a5fa; --warn-bg: #422006; --warn-ink: #fbbf24;
    }
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: Georgia, 'Iowan Old Style', 'Times New Roman', serif;
         background: var(--bg); color: var(--ink); line-height: 1.65; }
  .note { max-width: 860px; margin: 0 auto; padding: 48px 28px 80px; }
  h1 { font-size: 2em; letter-spacing: -0.02em; }
  h2 { font-size: 1.35em; margin: 40px 0 8px; padding-bottom: 6px;
       border-bottom: 2px solid var(--line); }
  h3 { font-size: 1.05em; margin: 28px 0 8px; }
  h4 { font-size: 0.95em; margin: 0 0 4px; }
  .masthead { color: var(--muted); font-size: 0.95em; }
  section.collapsed h2 { border-bottom-color: var(--panel); }
  p.reading { margin: 8px 0; font-size: 1.05em; }
  p.reading.unknown { color: var(--muted); }
  .headline { font-weight: 700; font-size: 1.15em; color: var(--accent); }
  p.qualifier { color: var(--muted); font-size: 0.9em; font-style: italic;
                margin-bottom: 8px; }
  .finding { border-left: 4px solid var(--neutral); background: var(--panel);
             padding: 10px 16px; margin: 12px 0; border-radius: 0 6px 6px 0; }
  .finding.good { border-left-color: var(--good); }
  .finding.bad { border-left-color: var(--bad); }
  .finding .headline { font-size: 1em; color: var(--ink); }
  .finding .detail { margin-top: 4px; font-size: 0.95em; }
  ul.unknowns { list-style: none; margin: 12px 0; }
  li.unknown { color: var(--muted); font-size: 0.95em; margin: 6px 0;
               padding-left: 14px; border-left: 2px dotted var(--line); }
  p.caveat { background: var(--warn-bg); color: var(--warn-ink);
             padding: 8px 14px; border-radius: 6px; margin: 12px 0;
             font-size: 0.9em; }
  p.caveat.note { background: var(--panel); color: var(--muted); }
  table { width: 100%; border-collapse: collapse; margin: 14px 0;
          font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
          font-size: 0.88em; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line);
           vertical-align: top; }
  thead th { color: var(--muted); text-transform: uppercase;
             letter-spacing: 0.06em; font-size: 0.82em; }
  tr.unknown td, tr.unknown th { color: var(--muted); }
  td.contribution, td.figure { white-space: nowrap; }
  table.years td, table.years th { text-align: right; }
  table.years th[scope="row"] { text-align: left; }
  a.explain { font-size: 0.82em; font-weight: 400; color: var(--accent);
              text-decoration: none; margin-left: 6px; white-space: nowrap; }
  a.explain::before { content: "↳ "; }
  .disclosure { padding: 10px 0; border-bottom: 1px solid var(--line); }
  .disclosure p { color: var(--muted); font-size: 0.95em; }
  footer { margin-top: 48px; color: var(--muted); font-size: 0.85em; }
</style>
</head>
<body>
<div class="note">

<header>
  <h1>{{ company }} — {{ title }}</h1>
  <p class="masthead">{{ subtitle }}</p>
  <p class="masthead">Generated: {{ generation_date }}</p>
</header>

{% macro section_block(section) %}
<section id="section-{{ section.key }}" class="{{ 'expanded' if section.expanded else 'collapsed' }}">
  <h2>{{ section.title }}</h2>
  {{ surface.render_reading(section.reading) }}
  {% if section.expanded %}
  {% for finding in section.findings %}
  {{ surface.render_finding(finding) }}
  {% endfor %}
  {% if section.rows %}
  <table>
    <thead><tr>
      <th>{{ row_headers[0] }}</th><th>{{ row_headers[1] }}</th><th>{{ row_headers[2] }}</th>
    </tr></thead>
    <tbody>
    {% for row in section.rows %}
    {{ surface.render_metric_row(row) }}
    {% endfor %}
    </tbody>
  </table>
  {% endif %}
  {% if section.unknowns %}
  <ul class="unknowns">
  {% for unknown in section.unknowns %}
  {{ surface.render_unknown(unknown) }}
  {% endfor %}
  </ul>
  {% endif %}
  {% for caveat in section.caveats %}
  {{ surface.render_caveat(caveat) }}
  {% endfor %}
  {% endif %}
</section>
{% endmacro %}
{{ section_block(lead) }}
{% for section in sections %}
{{ section_block(section) }}
{% endfor %}
{% if unscored %}
{{ section_block(unscored) }}
{% endif %}

<section id="appendix">
  <h2>Appendix</h2>

  {# R10: the multi-year tables live here rather than in a section body. #}
  {% if appendix.snapshot %}
  <h3>Ten-year snapshot</h3>
  <table class="years">
    <thead><tr><th>Year</th>{% for s in appendix.snapshot %}<th>{{ s.year[-4:] }}</th>{% endfor %}</tr></thead>
    <tbody>
      <tr><th scope="row">Revenue (₹ Cr)</th>{% for s in appendix.snapshot %}<td>{% if s.revenue is not none %}{{ "{:,.0f}".format(s.revenue) }}{% else %}not reported{% endif %}</td>{% endfor %}</tr>
      <tr><th scope="row">Profit after tax (₹ Cr)</th>{% for s in appendix.snapshot %}<td>{% if s.pat is not none %}{{ "{:,.0f}".format(s.pat) }}{% else %}not reported{% endif %}</td>{% endfor %}</tr>
      <tr><th scope="row">Earnings per share (₹)</th>{% for s in appendix.snapshot %}<td>{% if s.eps is not none %}{{ "%.1f"|format(s.eps) }}{% else %}not reported{% endif %}</td>{% endfor %}</tr>
      <tr><th scope="row">Operating margin (%)</th>{% for s in appendix.snapshot %}<td>{% if s.opm is not none %}{{ "%.1f"|format(s.opm) }}{% else %}not reported{% endif %}</td>{% endfor %}</tr>
      <tr><th scope="row">Return on capital employed (%)</th>{% for s in appendix.snapshot %}<td>{% if s.roce is not none %}{{ "%.1f"|format(s.roce) }}{% else %}not reported{% endif %}</td>{% endfor %}</tr>
      <tr><th scope="row">Debt to equity (times)</th>{% for s in appendix.snapshot %}<td>{% if s.de is not none %}{{ "%.2f"|format(s.de) }}{% else %}not reported{% endif %}</td>{% endfor %}</tr>
      <tr><th scope="row">Cash from operations (₹ Cr)</th>{% for s in appendix.snapshot %}<td>{% if s.cfo is not none %}{{ "{:,.0f}".format(s.cfo) }}{% else %}not reported{% endif %}</td>{% endfor %}</tr>
    </tbody>
  </table>
  {% endif %}

  {% if appendix.cashflow and appendix.cashflow.yearly_data %}
  <h3>Cash-flow history</h3>
  <p>Cumulative cash from operations against cumulative profit: {{ "%.0f"|format(appendix.cashflow.cumulative_ratio) }}%.</p>
  <table class="years">
    <thead><tr><th>Year</th><th>Cash from operations (₹ Cr)</th><th>Profit after tax (₹ Cr)</th><th>Cash as a share of profit (%)</th></tr></thead>
    <tbody>
    {% for yr in appendix.cashflow.yearly_data %}
      <tr><th scope="row">{{ yr.year[-4:] }}</th><td>{{ "{:,.0f}".format(yr.cfo) }}</td><td>{{ "{:,.0f}".format(yr.pat) }}</td><td>{% if yr.ratio is not none %}{{ "%.0f"|format(yr.ratio) }}{% else %}not comparable{% endif %}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}

  {% if appendix.shareholding %}
  <h3>Shareholding history</h3>
  <table class="years">
    <thead><tr><th>Quarter</th><th>Promoter (%)</th><th>Foreign institutions (%)</th><th>Domestic institutions (%)</th><th>Public (%)</th><th>Government (%)</th><th>Promoter shares pledged (%)</th></tr></thead>
    <tbody>
    {% for sh in appendix.shareholding %}
      <tr><th scope="row">{{ sh.quarter }}</th><td>{% if sh.promoter_pct is not none %}{{ "%.1f"|format(sh.promoter_pct) }}{% else %}not reported{% endif %}</td><td>{% if sh.fii_pct is not none %}{{ "%.1f"|format(sh.fii_pct) }}{% else %}not reported{% endif %}</td><td>{% if sh.dii_pct is not none %}{{ "%.1f"|format(sh.dii_pct) }}{% else %}not reported{% endif %}</td><td>{% if sh.public_pct is not none %}{{ "%.1f"|format(sh.public_pct) }}{% else %}not reported{% endif %}</td><td>{% if sh.govt_pct is not none %}{{ "%.1f"|format(sh.govt_pct) }}{% else %}not reported{% endif %}</td><td>{% if sh.promoter_pledge_pct is not none %}{{ "%.1f"|format(sh.promoter_pledge_pct) }}{% else %}not reported{% endif %}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}

  {% if appendix.signals or appendix.signal_unknowns %}
  <h3>Signals</h3>
  {% for finding in appendix.signals %}
  {{ surface.render_finding(finding) }}
  {% endfor %}
  {% if appendix.signal_unknowns %}
  <ul class="unknowns">
  {% for unknown in appendix.signal_unknowns %}
  {{ surface.render_unknown(unknown) }}
  {% endfor %}
  </ul>
  {% endif %}
  {% endif %}

  {# R3's deferred half: the explanations are reachable from every metric row
     above and appear nowhere in the reading flow. #}
  {% if appendix.disclosures %}
  <h3>What each metric measures</h3>
  {% for disclosure in appendix.disclosures %}
  {{ surface.render_disclosure(disclosure) }}
  {% endfor %}
  {% endif %}

  {% if appendix.caveats %}
  <h3>Run notes</h3>
  {% for caveat in appendix.caveats %}
  {{ surface.render_caveat(caveat) }}
  {% endfor %}
  {% endif %}
</section>

<footer>Generated by Boundless100x SQGLP Research System | {{ generation_date }}</footer>

</div>
</body>
</html>
